DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ACADEMIC_ENGINE_DETECTORS=local
ACADEMIC_ENGINE_INCLUDE_HF_DETECTOR=false
ACADEMIC_ENGINE_HF_DETECTOR_MODEL=openai-community/roberta-base-openai-detector
ACADEMIC_ENGINE_COMMUNITY_CANDIDATE_LIMIT=2
ACADEMIC_ENGINE_DETECTOR_EXECUTION=sequential
ACADEMIC_ENGINE_DETECTOR_CONCURRENCY=1
ACADEMIC_ENGINE_BINOCULARS_MODEL=tiiuae/falcon-7b
ACADEMIC_ENGINE_BINOCULARS_OBSERVER=tiiuae/falcon-7b-instruct
ACADEMIC_ENGINE_BINOCULARS_CLI=
ACADEMIC_ENGINE_GHOSTBUSTER_CLI=
ACADEMIC_ENGINE_MAGE_CLI=
ACADEMIC_ENGINE_RADAR_CLI=
ACADEMIC_ENGINE_OFFICIAL_BINOCULARS_CLI=
ACADEMIC_ENGINE_OFFICIAL_GHOSTBUSTER_CLI=
ACADEMIC_ENGINE_OFFICIAL_FAST_DETECTGPT_CLI=
ACADEMIC_ENGINE_OFFICIAL_DETECTOR_TIMEOUT_SECONDS=900
ACADEMIC_ENGINE_OFFICIAL_FLASH_ENDPOINT_ID=
ACADEMIC_ENGINE_OFFICIAL_FLASH_TIMEOUT_SECONDS=900
RUNPOD_API_KEY=
ACADEMIC_ENGINE_FLASH_DETECTORS=binoculars,ghostbuster,mage,radar
ACADEMIC_ENGINE_FLASH_MODE=production
ACADEMIC_ENGINE_FLASH_ENDPOINT_ID=
ACADEMIC_ENGINE_FLASH_BINOCULARS_ENDPOINT_ID=
ACADEMIC_ENGINE_FLASH_GHOSTBUSTER_ENDPOINT_ID=
ACADEMIC_ENGINE_FLASH_MAGE_ENDPOINT_ID=
ACADEMIC_ENGINE_FLASH_RADAR_ENDPOINT_ID=
ACADEMIC_ENGINE_FLASH_TIMEOUT_SECONDS=120

# Web/Vercel runtime controls. Keep secrets in Vercel Environment Variables,
# not in committed env files.
ACADEMIC_ENGINE_WEB_MAX_WORDS=4000
ACADEMIC_ENGINE_WEB_WORKERS=1
ACADEMIC_ENGINE_WEB_INLINE_JOBS=false
ACADEMIC_ENGINE_ENABLE_REMOTE_DETECTORS=true
ACADEMIC_ENGINE_REMOTE_MAX_WORDS=1200
ACADEMIC_ENGINE_REMOTE_DAILY_LIMIT=100
ACADEMIC_ENGINE_REMOTE_PER_IP_DAILY_LIMIT=5
ACADEMIC_ENGINE_REMOTE_MIN_INTERVAL_SECONDS=10
ACADEMIC_ENGINE_REMOTE_CACHE_TTL_HOURS=168
ACADEMIC_ENGINE_REMOTE_MAX_CONCURRENT_JOBS=1
ACADEMIC_ENGINE_WEB_HOST=127.0.0.1
ACADEMIC_ENGINE_WEB_PORT=8000
